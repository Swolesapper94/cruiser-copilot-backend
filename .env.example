DIAGNOSTIC_MODE=scripted

PORT=4000
# Comma-separated allow-list, e.g. https://app.example.com,https://admin.example.com
# Leave unset in local dev — any http(s)://localhost:* or 127.0.0.1:* origin is
# allowed automatically, since Next.js may move to 3001, 3002, etc.
CORS_ORIGIN=

# Live model (optional, OpenAI-compatible). Leave disabled for scripted mode.
ENABLE_LIVE_LLM=false
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Media description (optional; requires a live model too)
ENABLE_MEDIA_ANALYSIS=false
VISION_MODEL=

# Semantic retrieval (optional; exact matching always stays authoritative)
ENABLE_SEMANTIC_RETRIEVAL=false
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Optional persistence (unused by the in-memory MVP store)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Forum ingestion. Off by default. Enabling this is NOT sufficient on its own:
# each source also needs terms_review_status=approved and a recorded robots
# review before anything is fetched.
ENABLE_FORUM_INGESTION=false
INGESTION_USER_AGENT=
INGESTION_REQUEST_DELAY_MS=5000
INGESTION_MAX_PAGES_PER_RUN=25
# Required for POST /api/ingestion/forum/crawl (minimum 24 characters).
INGESTION_ADMIN_TOKEN=

MAX_UPLOAD_MB=25
MAX_VIDEO_SECONDS=30
